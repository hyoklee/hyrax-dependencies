--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -400,27 +400,41 @@
 install(FILES ${DAP_HDR} ${DAP_GENERATED_HDR} ${DAP4_ONLY_HDR} ${CLIENT_HDR} ${SERVER_HDR}
         DESTINATION include/libdap)
 
+# BES's dapreader (and other) modules include the libdap Test* factory headers
+# as <test/TestTypeFactory.h> from the installed tree. Install them under
+# include/libdap/test/ so downstream builds against installed libdap resolve them.
+file(GLOB DAP_TEST_HDR "${CMAKE_CURRENT_SOURCE_DIR}/tests/*.h")
+install(FILES ${DAP_TEST_HDR} DESTINATION include/libdap/test)
+
 include(CTest)      # defines the BUILD_TESTING option (defaults ON)
 enable_testing()
+# test-types (built in tests/) is a runtime dependency of downstream code
+# (e.g. BES's dapreader module), so build/install it unconditionally. The
+# test executables inside tests/ are still guarded by BUILD_TESTING.
 add_subdirectory(tests)
+if(BUILD_TESTING)
 add_subdirectory(unit-tests)
 add_subdirectory(d4_ce/unit-tests)
 add_subdirectory(http_dap/unit-tests)
+endif(BUILD_TESTING)
 
 # a target that runs only the unit tests
+if(BUILD_TESTING)
 add_custom_target(unit-test
         COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure --parallel --label-regex unit
-        DEPENDS unit-tests)            # or whatever your unit‐test target is
+        DEPENDS unit-tests)
+endif(BUILD_TESTING)            # or whatever your unit‐test target is
 
 # a target that runs only the integration tests, These can't run in parallel :(
+if(BUILD_TESTING)
 add_custom_target(integration-test
         COMMAND ${CMAKE_CTEST_COMMAND} --output-on-failure --label-regex integration
-        DEPENDS tests)                 # or your integration‐test deps
+        DEPENDS tests)
 
-# a “check” target to do unit → integration in order
 add_custom_target(check
         DEPENDS unit-test integration-test
 )
+endif(BUILD_TESTING)
 
 # Custom cleanup for coverage files, etc.
 set_directory_properties(PROPERTIES
